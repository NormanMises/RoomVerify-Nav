# Copy this file to .env and supply your own credentials and deployment endpoint.
# Models and inference settings from the latest recorded experiments (2026-10-18).

export OPENAI_API_KEY=your-api-key
# Use your provider's OpenAI-compatible deployment URL.
export OPENAI_API_BASE=https://your-endpoint.example.com/compatible-mode/v1

# Text reasoning and image-based verification use the same model.
export OPENAI_MODEL=qwen3.8-flash
export OPENAI_VISION_MODEL=qwen3.8-flash
export OPENAI_TEMPERATURE=0.0
export OPENAI_ENABLE_THINKING=1

# Reasoning effort for target-room priors, verification, and room inference.
export TARGET_GUIDANCE_REASONING_EFFORT=medium
export TARGET_VERIFY_REASONING_EFFORT=low
export PROMPTING_ROOM_REASONER_REASONING_EFFORT=low
